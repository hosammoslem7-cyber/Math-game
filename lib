void saveToVector(string FileName, vector<string> &vFile)
{
    fstream MyFile;
    MyFile.open(FileName, ios::out);
    if (MyFile.is_open())
    {
        string Line;
        for (string &Line : vFile)
        {
            if(Line!="")
            MyFile << Line << "\n";
        }
        MyFile.close();
